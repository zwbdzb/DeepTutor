# ============================================
# DeepTutor Project .gitignore
# ============================================

# ============================================
# User Generated Data and Outputs
# ============================================
# Runtime data (knowledge bases, partner workspaces, memory, etc.)
data/
/multi-user/
# Developer and agent documentation is tracked in docs-for-dev/.
# Keep obsolete local notes and downloaded references out of the repository.
/docs/
/docs-for-use/
/docs-for-user/
/design-qa.md
# Local development screenshots, acceptance snapshots, and task reports.
/artifacts/
/.github/tdd/
/site/
.claude
.agents/
.workbuddy/
# 本地品牌图标工具与部署回滚备份（build_icon.py / gen_assets.py /
# rebuild_shell.py + 旧版 exe 备份），本机工作产物，不入库。
.iconwork/
desktop-shell/pip-*/
desktop-shell/tmp????????*

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.pdf
!tests/fixtures/lightrag_bridge/original.pdf
!tests/fixtures/lightrag_bridge/mineru-v2-current/*_origin.pdf

# ============================================
# Python Related
# ============================================
# Bytecode cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution/Packaging
# Generated by prepare_web_package.py; the source wrapper remains tracked.
/deeptutor_web/*
!/deeptutor_web/__init__.py
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environment configuration (keep the public template)
.env
.env.*
*.env
*.env.local
!.env.example

# Virtual environments
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/

# ============================================
# Node.js and Frontend Build
# ============================================
# Node modules
# No trailing slash: also ignore symlinked installs borrowed by worktrees.
node_modules
# pnpm metadata generated locally; this project tracks package-lock.json instead.
web/pnpm-lock.yaml
web/pnpm-workspace.yaml
# npm lockfile accidentally generated at repo root (npm install run in the
# wrong cwd); the real one is web/package-lock.json.
/package-lock.json

# PyInstaller workpath (build cache: .toc/.pyz/.pkg/xref/warn — regenerated
# every build; keeping it locally speeds up incremental shell builds).
desktop-shell/build/ThinkBuddyDesktop/

# Next.js build output
.next/
# Custom distDir builds (DEEPTUTOR_NEXT_DIST_DIR / parallel dev servers)
web/.next-*/
# Build-tool state stamps (fingerprints written by build\build.ps1)
web/.web-build-stamp
web/.deeptutor_web-stamp
# PDF.js decoder files are copied from node_modules for local/dev and release
# builds; they are dependency-generated assets, not source files.
web/public/pdfjs/
web/public/pptx-preview/pptx-preview.umd.js

# ---------------------------------------------------------------------------
# deeptutor_web —— pip 打包时由 scripts/prepare_web_package.py 从
# web/.next/standalone 重新生成的完整前端运行时目录（server.js 单文件服务 +
# 静态资源）。除已跟踪的包存根 __init__.py 外，其余全部是构建产物，不入库。
# ---------------------------------------------------------------------------
deeptutor_web/BUILD_INFO
deeptutor_web/server.js
deeptutor_web/server.js.map
deeptutor_web/package.json
deeptutor_web/package-lock.json
deeptutor_web/public/
deeptutor_web/.next/
deeptutor_web/.next-*/
deeptutor_web/node_modules/
# Per-process TypeScript configs used by isolated build/typecheck wrappers
web/tsconfig.deeptutor-*.json
# Temporary Next.js dist roots created by isolated build/test runs
web/tmp/
out/
.vercel/
.turbo/

# Frontend build artifacts
.open-next/
.wrangler/
.vite/

# Yarn / Plug'n'Play
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# TypeScript build info
*.tsbuildinfo

# ============================================
# Common Output and Cache Directories
# ============================================
# Output directories
output/
outputs/

# Cache directories
cache/
.cache/
.ruff_cache
.import_linter_cache/
.playwright-cli/
# Written by `npm run audit` (the playwright ui-audit project).
web/test-results/
web/playwright-report/

# Log files
*.log

# ============================================
# IDE and Editors
# ============================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Cursor
.cursor/

# PyCharm / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

